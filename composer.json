{
  "name": "selcukmart/smart-autoload-converter",
  "description": "Convert legacy PHP projects from include/require to PSR-4 autoloading",
  "type": "library",
  "license": "MIT",
  "keywords": ["php", "psr-4", "autoloading", "migration", "legacy", "namespace", "converter"],
  "homepage": "https://github.com/selcukmart/smart-autoload-converter",
  "authors": [
    {
      "name": "Selcuk Mart",
      "homepage": "https://github.com/selcukmart"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-zip": "*",
    "psr/log": "^3.0",
    "symfony/console": "7.4.*",
    "symfony/finder": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/var-dumper": "7.4.*"
  },
  "bin": [
    "bin/smart-autoload-converter"
  ],
  "autoload": {
    "psr-4": {
      "SmartAutoloadConverter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SmartAutoloadConverter\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "test:coverage": "phpunit"
  }
}
